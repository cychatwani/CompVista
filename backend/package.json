{
  "name": "compvista-api",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "prisma generate && nest build",
    "typecheck": "tsc -p tsconfig.check.json",
    "start": "node dist/main.js",
    "lint": "eslint src test scripts --ext .ts",
    "test": "node --import tsx --test test/hello.test.ts test/seed-plan.test.ts test/password-policy.test.ts",
    "test:integration": "node --import tsx --test test/seed.integration.test.ts",
    "db:check": "tsx scripts/check-db.ts",
    "db:migrate": "node scripts/flyway.mjs migrate",
    "db:validate": "node scripts/flyway.mjs validate",
    "db:info": "node scripts/flyway.mjs info",
    "seed:dev": "tsx scripts/seed-dev.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.27",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.27",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^16.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
