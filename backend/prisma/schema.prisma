generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           user         @relation(fields: [inviterId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email])
  @@index([organizationId])
}

model member {
  id                String             @id
  organizationId    String
  userId            String             @unique(map: "uq_member_user_id")
  role              String             @default("member")
  createdAt         DateTime
  roleId            String?
  organization      organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization_role organization_role? @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: NoAction, onUpdate: NoAction, map: "member_role_org_fk")
  user              user               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([organizationId])
}

model organization {
  id                String              @id
  name              String
  slug              String              @unique
  logo              String?
  createdAt         DateTime
  metadata          String?
  employee          employee[]
  invitation        invitation[]
  member            member[]
  organization_role organization_role[]
  compensation_component_definition compensation_component_definition[]
  employee_compensation employee_compensation[]
}

model session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 user     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model twoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    user      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([secret])
  @@index([userId])
}

model user {
  id               String       @id
  name             String
  email            String       @unique
  emailVerified    Boolean      @default(false)
  image            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime
  twoFactorEnabled Boolean?     @default(false)
  mustChangePassword Boolean    @default(false)
  account          account[]
  employee         employee?
  invitation       invitation[]
  member           member?
  session          session[]
  twoFactor        twoFactor[]
  emailVerificationOtp email_verification_otp?
  createdCompensation employee_compensation[]
}

model email_verification_otp {
  userId    String   @id
  email     String
  codeHash  String
  expiresAt DateTime @db.Timestamptz(6)
  sentAt    DateTime @db.Timestamptz(6)
  attempts  Int      @default(0)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([identifier])
}

model employee {
  id             String       @id
  userId         String       @unique
  organizationId String
  displayName    String
  createdAt      DateTime     @default(now())
  organization   organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           user         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  compensation   employee_compensation[]

  @@unique([id, organizationId], map: "employee_id_organization_key")
  @@index([organizationId])
}

enum compensation_category {
  EARNING
  EMPLOYER_CONTRIBUTION
  EMPLOYEE_DEDUCTION
}

enum compensation_status {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum compensation_calculation_type {
  FIXED
  PERCENTAGE_OF_BASE
}

model currency {
  code String @id @db.Char(3)
  name String
  symbol String
  decimal_places Int @db.SmallInt
  is_active Boolean @default(true)
  packages employee_compensation[]
}

model compensation_component_definition {
  id String @id @db.Uuid
  organization_id String
  code String
  name String
  category compensation_category
  is_basic Boolean @default(false)
  is_active Boolean @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  organization organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  items employee_compensation_item[]

  @@unique([organization_id, code])
  @@unique([id, organization_id])
}

model employee_compensation {
  id String @id @db.Uuid
  organization_id String
  employee_id String
  currency_code String @db.Char(3)
  status compensation_status
  effective_from DateTime @db.Date
  effective_to DateTime? @db.Date
  version Int @default(1)
  created_by String
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  organization organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  employee employee @relation(fields: [employee_id, organization_id], references: [id, organizationId], onDelete: Restrict)
  currency currency @relation(fields: [currency_code], references: [code], onDelete: Restrict)
  creator user @relation(fields: [created_by], references: [id], onDelete: Restrict)
  items employee_compensation_item[]

  @@index([organization_id, employee_id, created_at(sort: Desc)], map: "employee_compensation_employee_idx")
}

model employee_compensation_item {
  id String @id @db.Uuid
  compensation_id String @db.Uuid
  component_definition_id String @db.Uuid
  calculation_type compensation_calculation_type
  fixed_amount Decimal? @db.Decimal(20, 4)
  percentage Decimal? @db.Decimal(9, 4)
  resolved_monthly_amount Decimal @db.Decimal(20, 4)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
  compensation employee_compensation @relation(fields: [compensation_id], references: [id], onDelete: Cascade)
  definition compensation_component_definition @relation(fields: [component_definition_id], references: [id], onDelete: Restrict)

  @@unique([compensation_id, component_definition_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model organization_role {
  id                            String                         @id
  organizationId                String
  key                           String
  displayName                   String
  member                        member[]
  organization                  organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization_role_permissions organization_role_permissions?

  @@unique([id, organizationId])
  @@unique([organizationId, key])
}

model organization_role_permissions {
  roleId               String            @id
  canViewAllComp       Boolean           @default(false)
  canViewOwnComp       Boolean           @default(false)
  canProposeOthersComp Boolean           @default(false)
  canProposeOwnComp    Boolean           @default(false)
  canApproveComp       Boolean           @default(false)
  canApproveOwnComp    Boolean           @default(false)
  requiresApproval     Boolean           @default(true)
  organization_role    organization_role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
